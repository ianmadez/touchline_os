# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# the browser target's export, which is also its build directory (see next.config.ts)
/out-browser/

# browser target assets
# The SQLite engine is staged from node_modules by scripts/with-target.mjs. The parser's reference data
# is committed in public/parse-resources/ - see the README there for its provenance and licensing.
/public/sql-wasm.wasm

# The local build's face cache: one file per player sprite, fetched from the CDN for whoever's save is
# open. This is per-career artwork, not part of the product - committing it shipped one manager's squad
# to every clone, and it was committed until 2026-10-11. The browser target never reads this folder (it
# caches in the browser's own storage instead), and a fresh local checkout fills it on its first sync.
/public/faces/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

references/fc26companion/
references/manager-companion/
references/ 

/data/

# Benched FC 27 save-decoding probes. Kept out of history on purpose.
scripts/probes/
